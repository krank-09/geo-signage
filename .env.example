# Copy to .env (docker compose reads it automatically). Never commit the real .env.

# --- required before exposing the server through a tunnel ---
SECRET_KEY=replace-with-a-long-random-string     # e.g. `openssl rand -hex 32`
ADMIN_PASSWORD=replace-with-a-strong-password    # used only when the database is first created

# 0 = seeded devices get random registration tokens, printed once in the backend log:
#       docker compose logs backend | grep "Registration token"
# 1 = well-known DEMO-REG-001..003 tokens (required for `--profile sim`; do NOT use on a public URL)
FIXED_DEMO_TOKENS=0

# --- tuning for tunnel demos ---
MAX_UPLOAD_MB=90                  # Cloudflare's free plan rejects request bodies over 100 MB
OFFLINE_THRESHOLD_SECONDS=45      # tolerate short internet blips before a display is marked offline

# --- optional: ngrok tunnel (./scripts/tunnel.sh start ngrok) ---
# Free account: https://dashboard.ngrok.com  ->  authtoken, and (Domains) one free static domain.
# With a static domain the public URL never changes, so display laptops are configured only once.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- host ports (change if something else already uses them) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

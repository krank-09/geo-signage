# Device settings. start.sh / start.bat create a `.env` from your answers; you can also copy this file to `.env` by hand.

# The URL the presenter gives you. The tunnel root, or the root + /api, both work.
SERVER_URL=https://example-name.trycloudflare.com/api
DEVICE_ID=DEV-001
REGISTRATION_TOKEN=XXXX-XXXX-XXXX

# Local page the agent serves (open http://localhost:<port>)
DISPLAY_PORT=8101

# Open the display page automatically. KIOSK=1 tries Chrome/Edge fullscreen (exit with Alt+F4 / Cmd+Q).
OPEN_BROWSER=1
KIOSK=0

# Location source. Laptops have no GPS, so the default is a simulated road trip.
# GPS_MODE: sim | fixed | gpsd
GPS_MODE=sim
ROUTE=chandigarh,delhi,jaipur,mumbai     # known places: chandigarh, delhi, jaipur, mumbai, ahmedabad
ROUTE_STEPS=8                            # ticks between places (one tick ~ every 3 s)
ROUTE_DWELL=6                            # ticks spent at each place
# For GPS_MODE=fixed:
LAT=28.6139
LNG=77.2090
